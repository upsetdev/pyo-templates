{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pyo template (built)",
  "description": "One entry of dist/v1/index.json: what scripts/compose.ts makes of a template's compose.yaml. Pyo reads only this.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "description",
    "category",
    "tier",
    "author",
    "version",
    "minPyoVersion",
    "source",
    "kind",
    "workload",
    "stateful",
    "replicas",
    "resources",
    "ports",
    "healthCheck",
    "env",
    "fields",
    "hints"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 50,
      "description": "Must match the folder. Never renamed: services and backups refer to it."
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 160
    },
    "category": {
      "enum": [
        "databases",
        "caches",
        "storage",
        "networking",
        "monitoring",
        "messaging",
        "developer-tools",
        "web",
        "ai",
        "other"
      ]
    },
    "logo": {
      "type": "string",
      "const": "logo.svg",
      "description": "An SVG next to this file. Without one, Pyo shows a generic icon."
    },
    "tier": {
      "enum": [
        "official",
        "community"
      ]
    },
    "author": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?$",
      "maxLength": 39,
      "description": "GitHub username."
    },
    "minPyoVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "The template's own version (semver), not the app's. Bump it on every change: patch for an image bump, minor for a new option, major for a change that needs people to act. Pyo records it with each service deployed from the template.",
      "examples": [
        "1.0.0"
      ]
    },
    "appVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "The app's version that the default image tag runs, as people know it (0.107.55 for the tag v0.107.55). Leave it out when the tag doesn't say."
    },
    "upgrade": {
      "type": "object",
      "additionalProperties": false,
      "description": "Reserved: how services on an earlier version move to this one. Pyo doesn't read it yet.",
      "properties": {
        "breaking": {
          "type": "boolean",
          "description": "Moving to this version needs people to act (a data migration, a changed variable)."
        },
        "upgradeFrom": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "The template versions that can move to this one, as a semver range (>=1.2.0 <2.0.0)."
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "What changes, shown before upgrading."
        }
      }
    },
    "source": {
      "type": "object",
      "description": "A container image. The first version is the default.",
      "additionalProperties": false,
      "required": [
        "type",
        "image",
        "versions"
      ],
      "properties": {
        "type": {
          "const": "image"
        },
        "image": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+\\.[a-z]+(:[0-9]+)?/[a-z0-9._/-]+$",
          "description": "With its registry, without a tag."
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "digest"
            ],
            "properties": {
              "tag": {
                "type": "string",
                "minLength": 1,
                "description": "Quote it: 17.2 alone is a number in YAML."
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "kind": {
      "enum": [
        "application",
        "service"
      ]
    },
    "workload": {
      "enum": [
        "Deployment",
        "StatefulSet"
      ]
    },
    "stateful": {
      "type": "boolean"
    },
    "replicas": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpuRequest",
        "cpuLimit",
        "memoryRequest",
        "memoryLimit"
      ],
      "properties": {
        "cpuRequest": {
          "type": "integer",
          "minimum": 1,
          "description": "Millicores."
        },
        "cpuLimit": {
          "type": "integer",
          "minimum": 1
        },
        "memoryRequest": {
          "type": "integer",
          "minimum": 1,
          "description": "MiB."
        },
        "memoryLimit": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "use",
        "count"
      ],
      "description": "NVIDIA GPUs. optional: offered when the cluster has a GPU server, and it runs on CPU otherwise. required: it only deploys where there are GPUs.",
      "properties": {
        "use": {
          "enum": [
            "optional",
            "required"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "Whole GPUs to ask for, all on one server."
        }
      }
    },
    "args": {
      "type": "array",
      "maxItems": 64,
      "description": "Arguments to the image's own entrypoint, passed as they are (no shell runs them). {{key}} is replaced with a field's value.",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "sizeGi",
        "mountPath"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "sizeGi": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/.+"
        }
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "port",
          "protocol",
          "exposure"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "maxLength": 15
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "protocol": {
            "enum": [
              "HTTP",
              "TCP",
              "UDP"
            ]
          },
          "exposure": {
            "enum": [
              "internal",
              "http",
              "nodeport",
              "loadbalancer"
            ]
          }
        }
      }
    },
    "healthCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "initialDelaySeconds",
        "periodSeconds"
      ],
      "properties": {
        "type": {
          "enum": [
            "http",
            "tcp",
            "exec",
            "none"
          ]
        },
        "path": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "command": {
          "type": "string"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "value": {
            "type": "string"
          },
          "secret": {
            "type": "boolean"
          },
          "generate": {
            "type": "boolean",
            "description": "Pyo creates the value when deploying."
          },
          "format": {
            "enum": [
              "long",
              "hex-32",
              "base64-32"
            ],
            "description": "password (default): 24 letters and digits. long: 64 letters and digits. hex-32: 32 random bytes as 64 hex digits. base64-32: 32 random bytes, base64 (e.g. an AES-256 key)."
          },
          "prefix": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_:.-]{1,16}$",
            "description": "Put before the value, e.g. sk- or base64:."
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "description": "What people can set in the deploy form. The version picker comes from source.versions.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "type",
          "required"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "text",
              "number",
              "password",
              "select",
              "boolean"
            ]
          },
          "default": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "required": {
            "type": "boolean"
          },
          "sensitive": {
            "type": "boolean"
          },
          "envKey": {
            "type": "string"
          },
          "help": {
            "type": "string"
          }
        }
      }
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "homepage": {
      "type": "string",
      "pattern": "^https://[^\\s]+$",
      "maxLength": 200,
      "description": "The upstream project's website."
    },
    "featured": {
      "type": "boolean"
    },
    "hidden": {
      "type": "boolean",
      "description": "Left out of galleries; services already using it keep working."
    },
    "entrypoint": {
      "type": "array",
      "maxItems": 64,
      "description": "Replaces the image's entrypoint, passed as it is (no shell).",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "companions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "image",
          "version",
          "workload",
          "stateful",
          "replicas",
          "resources",
          "ports",
          "healthCheck",
          "env"
        ],
        "description": "A service deployed next to the template's own (e.g. Plausible's ClickHouse). Its variables have values; the main service reaches it at ${{<name>.HOST}}.",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 20
          },
          "image": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+\\.[a-z]+(:[0-9]+)?/[a-z0-9._/-]+$",
            "description": "With its registry, without a tag."
          },
          "version": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "digest"
            ],
            "properties": {
              "tag": {
                "type": "string",
                "minLength": 1,
                "description": "Quote it: 17.2 alone is a number in YAML."
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          },
          "workload": {
            "enum": [
              "Deployment",
              "StatefulSet"
            ]
          },
          "stateful": {
            "type": "boolean"
          },
          "replicas": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cpuRequest",
              "cpuLimit",
              "memoryRequest",
              "memoryLimit"
            ],
            "properties": {
              "cpuRequest": {
                "type": "integer",
                "minimum": 1,
                "description": "Millicores."
              },
              "cpuLimit": {
                "type": "integer",
                "minimum": 1
              },
              "memoryRequest": {
                "type": "integer",
                "minimum": 1,
                "description": "MiB."
              },
              "memoryLimit": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "args": {
            "type": "array",
            "maxItems": 64,
            "description": "Arguments to the image's own entrypoint, passed as they are (no shell runs them). {{key}} is replaced with a field's value.",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "entrypoint": {
            "type": "array",
            "maxItems": 64,
            "description": "Replaces the image's entrypoint, passed as it is (no shell).",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "storage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "required",
              "sizeGi",
              "mountPath"
            ],
            "properties": {
              "required": {
                "type": "boolean"
              },
              "sizeGi": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2000
              },
              "mountPath": {
                "type": "string",
                "pattern": "^/.+"
              }
            }
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "port",
                "protocol",
                "exposure"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$",
                  "maxLength": 15
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "protocol": {
                  "enum": [
                    "HTTP",
                    "TCP",
                    "UDP"
                  ]
                },
                "exposure": {
                  "enum": [
                    "internal",
                    "http",
                    "nodeport",
                    "loadbalancer"
                  ]
                }
              }
            }
          },
          "healthCheck": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "initialDelaySeconds",
              "periodSeconds"
            ],
            "properties": {
              "type": {
                "enum": [
                  "http",
                  "tcp",
                  "exec",
                  "none"
                ]
              },
              "path": {
                "type": "string"
              },
              "port": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "command": {
                "type": "string"
              },
              "initialDelaySeconds": {
                "type": "integer",
                "minimum": 0
              },
              "periodSeconds": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "env": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "value"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "databases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "engine",
          "env"
        ],
        "description": "A database it needs. When deploying, people pick one of their team's or make one, and Pyo connects it: each key in env becomes one of the service's variables, set from the database's own (its Connect values, or their parts).",
        "properties": {
          "engine": {
            "enum": [
              "mysql",
              "postgres",
              "kv"
            ]
          },
          "env": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[A-Z_]+(:[A-Z_]+)*$",
              "description": "One of the database's variables, or several joined by \":\" (MYSQL_HOST:MYSQL_PORT is host:port)."
            }
          },
          "extensions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_-]+$"
            },
            "description": "Extensions it needs, by name from Pyo's catalog: Postgres extensions, or KV modules (valkey-json, valkey-bloom, valkey-search). Pyo turns on the ones it manages: with a new database, or, for an existing one, when people agree in the deploy form. The other Postgres ones (pg_trgm, citext, pgcrypto…) the app creates itself with CREATE EXTENSION.",
            "examples": [
              [
                "pg_trgm"
              ]
            ]
          }
        }
      },
      "description": "Databases it needs, one per engine."
    }
  }
}
